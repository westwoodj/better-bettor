# Example environment variables for nfl-data-aggregator
# Copy to `.env` and populate with your keys.

GOOGLE_GENAI_API_KEY=
GOOGLE_GENAI_MODEL=models/text-bison-001
SPORTS_DATA_API_KEY=
ODDS_API_KEY=

# Database
DATABASE_URL=sqlite:///gridiron_oracle.db

# DSPy / LLM configuration
DSPY_LM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DSPY_MODEL=claude-sonnet-4-20250514
DSPY_TEMPERATURE_ANALYSIS=0.3
DSPY_TEMPERATURE_PREDICTION=0.1

# NFL data
NFL_SEASON=2026
